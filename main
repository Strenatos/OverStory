    def draw_hint_popup(self):
        if not self.hint_popup_active:
            return

        popup_x = 10
        popup_y = self.GAME_HEIGHT - 60
        popup_width = 280
        popup_height = 50

        self.canvas.delete('hint_popup')

        self.canvas.create_rectangle(popup_x, popup_y, popup_x + popup_width, popup_y + popup_height,
                                    fill='black', outline='purple', width=2, tags='hint_popup')

        self.canvas.create_text(popup_x + popup_width // 2, popup_y + 10,
                            text="HINT",
                            fill='purple', font=('Arial', 8, 'bold'), tags='hint_popup')

        self.canvas.create_text(popup_x + popup_width // 2, popup_y + 30,
                            text=self.hint_popup_text,
                            fill='white', font=('Arial', 8),
                            width=popup_width - 20, tags='hint_popup')

        self.hint_popup_timer -= 1
        if self.hint_popup_timer <= 0:
            self.hint_popup_active = False
            self.canvas.delete('hint_popup')

    def unlock_developer_skin(self):
        #Unlock the developer achievement from hidden credits button
        if not self.achievements['secret_developer']['unlocked']:
            self.unlock_achievement('secret_developer')
            # Show notification
            for dx in (-2,0,2):
                for dy in (-2,0,2):
                    if dx or dy:
                        self.canvas.create_text(300+dx,150+dy,text="🎨 Developer Achievement Unlocked!",
                                                fill='white',font=('Arial',18,'bold'),tags='credits')

            self.canvas.create_text(300,150,text="🎨 Developer Achievement Unlocked!",
                                    fill='orange',font=('Arial',18,'bold'),tags='credits')


    def check_master_skin(self):
        # Check if user has unlocked all other skins to unlock Master Collector
        # Get all skins except default and skin_master itself
        skins_to_check = [skin_id for skin_id in self.skins.keys()
                         if skin_id not in ['default', 'skin_master']]

        all_unlocked = True
        for skin_id in skins_to_check:
            if not self.is_skin_unlocked(skin_id):
                all_unlocked = False
                break

        return all_unlocked

    def is_skin_unlocked(self, skin_id):
        if skin_id in ['default', 'skin_starter_1', 'skin_starter_2', 'skin_starter_3']:
            return True
        if skin_id == 'skin_master':
            return self.check_master_skin()
        if skin_id in self.purchased_skins:
            return True
        for ach in self.achievements.values():
            if ach.get('reward') == skin_id and ach['unlocked']:
                return True
        if skin_id == 'skin_bonus' and self.achievements['the_collector']['unlocked']:
            return True
        return False
    

    def show_achievements(self):
        self.game_state = 'achievements'  
        self.menu_bullets = []
        self.menu_animation_timer = 0
        self.canvas.delete('all')

        self.canvas.create_text(300, 20, text="ACHIEVEMENTS", fill='gold',
                               font=('Arial', 24, 'bold'), tags='achievements')

        # Count unlocked achievements
        total = len(self.achievements)
        unlocked_count = sum(1 for ach in self.achievements.values() if ach['unlocked'])

        self.canvas.create_text(300, 45, text=f"{unlocked_count}/{total} Unlocked",
                               fill='cyan', font=('Arial', 12), tags='achievements')

        # Pagination settings
        achievements_per_page = 12
        achievement_list = list(self.achievements.items())
        total_pages = (len(achievement_list) + achievements_per_page - 1) // achievements_per_page
        total_pages += 1  # Add empty page 3
        
        if self.achievement_page == total_pages - 1:
            # Empty page
            self.canvas.create_text(300, 180, text="there's nothing here!",
                                fill='white', font=('Arial', 15, 'bold'), tags='achievements')
            self.canvas.create_text(300, 210, text="yet...",
                                fill='gray', font=('Arial', 8), tags='achievements')
                    
        # Calculate which achievements to show on current page
        start_idx = self.achievement_page * achievements_per_page
        end_idx = min(start_idx + achievements_per_page, len(achievement_list))
        achievements_to_show = achievement_list[start_idx:end_idx]

        # Display page number
        self.canvas.create_text(300, 62, text=f"Page {self.achievement_page + 1}/{total_pages}",
                               fill='yellow', font=('Arial', 10), tags='achievements')

        # Display achievements in a 4-column grid
        y_start = 80
        x_positions = [75, 225, 375, 525]  # 4 columns
        achievements_per_row = 4
        box_width = 140
        box_height = 70

        current_x_idx = 0
        current_y = y_start

        for ach_id, ach in achievements_to_show:
            x = x_positions[current_x_idx]

            # Skip hidden achievements that aren't unlocked
            if ach['hidden'] and not ach['unlocked']:
                self.canvas.create_rectangle(x - box_width//2, current_y,
                                            x + box_width//2, current_y + box_height,
                                            fill='black', outline='darkgray', width=1, tags=f'hint_{ach_id}')
                self.canvas.create_text(x, current_y + box_height//2, text="??? HIDDEN ???",
                                    fill='darkgray', font=('Arial', 8, 'italic'), tags=f'hint_{ach_id}')

                # Bind click to show hint
                if ach_id in self.achievement_hints:
                    self.canvas.tag_bind(f'hint_{ach_id}', '<Button-1>',
                                        lambda e, a=ach_id: self.show_hint(a))
            else:
                # Achievement box
                box_color = 'darkgreen' if ach['unlocked'] else 'darkgray'
                self.canvas.create_rectangle(x - box_width//2, current_y,
                                            x + box_width//2, current_y + box_height,
                                             fill=box_color, outline='white', width=2, tags='achievements')

                # Icon
                icon_text = ach['icon'] if ach['unlocked'] else '🔒'
                self.canvas.create_text(x - 40, current_y + box_height//2, text=icon_text,
                                       font=('Arial', 16), tags='achievements')

                # Name
                name_color = 'yellow' if ach['unlocked'] else 'gray'
                self.canvas.create_text(x + 10, current_y + 20, text=ach['name'],
                                       fill=name_color, font=('Arial', 8, 'bold'),
                                       tags='achievements', width=1000)

                # Description
                desc_color = 'white' if ach['unlocked'] else 'darkgray'
                font_size = ach.get('font_size', 9)

                self.canvas.create_text(
                    x + 15,
                    current_y + 42,
                    text=ach['description'],
                    fill=desc_color,
                    font=('Arial', font_size),
                    tags='achievements',
                    width=80
                )

                # Show reward icon if unlocked
                if ach['unlocked'] and ach['reward']:
                    self.canvas.create_text(x + box_width//2 - 10, current_y + 10, text="🎨",
                                           font=('Arial', 12), tags='achievements')

            # Move to next position
            current_x_idx += 1
            if current_x_idx >= achievements_per_row:
                current_x_idx = 0
                current_y += box_height + 10

        # Navigation buttons row
        button_y = 340

        # Previous page button (only show if not on first page)
        if self.achievement_page > 0:
            self.canvas.create_rectangle(50, button_y, 150, button_y + 30,
                                         fill='darkblue', outline='white',
                                         width=3, tags='prev_button')
            self.canvas.create_text(100, button_y + 15, text="◄ PREV", fill='white',
                                   font=('Arial', 14, 'bold'), tags='prev_button')
            self.canvas.tag_bind('prev_button', '<Button-1>', 
                                lambda e: self.change_achievement_page(-1))

        # Skins button (center)
        self.canvas.create_rectangle(200, button_y - 20, 400, button_y + 10,
                                     fill='purple', outline='white',
                                     width=3, tags='skins_button')
        self.canvas.create_text(300, button_y - 5, text="SKINS", fill='white',
                               font=('Arial', 16, 'bold'), tags='skins_button')
        self.canvas.tag_bind('skins_button', '<Button-1>', lambda e: self.show_skins())

        # Next page button (only show if not on last page)
        if self.achievement_page < total_pages - 1:
            self.canvas.create_rectangle(450, button_y, 550, button_y + 30,
                                         fill='darkblue', outline='white',
                                         width=3, tags='next_button')
            self.canvas.create_text(500, button_y + 15, text="NEXT ►", fill='white',
                                   font=('Arial', 14, 'bold'), tags='next_button')
            self.canvas.tag_bind('next_button', '<Button-1>', 
                                lambda e: self.change_achievement_page(1))

        # Back button (bottom)
        self.canvas.create_rectangle(200, 360, 400, 395,
                                     fill='darkgreen', outline='white',
                                     width=3, tags='back_button')
        self.canvas.create_text(300, 380, text="BACK", fill='white',
                               font=('Arial', 16, 'bold'), tags='back_button')
        self.canvas.tag_bind('back_button', '<Button-1>', lambda e: self.leave_achievements())

        if self.hint_popup_active:
            self.draw_hint_popup()

    def change_achievement_page(self, direction):
        self.hint_popup_active = False
        self.hint_popup_text = ''
        self.canvas.delete('hint_popup')
        self.achievement_page += direction
        self.show_achievements()

    def change_skin_page(self, direction):
        # Change skin page
        self.skin_page += direction
        self.show_skins()

    def show_hint(self, achievement_id):
        if achievement_id in self.achievement_hints:
            self.hint_popup_active = True
            self.hint_popup_timer = 240
            self.hint_popup_text = self.achievement_hints[achievement_id]
            # Don't call update_hint_popup at all

    def show_skins(self):
        self.game_state = 'skins'  
        self.menu_bullets = []
        self.menu_animation_timer = 0
        self.canvas.delete('all')

        self.canvas.create_text(300, 20, text="PLAYER SKINS", fill='magenta',
                               font=('Arial', 24, 'bold'), tags='skins')

        self.canvas.create_text(300, 45, text="Click a skin to equip it!",
                               fill='cyan', font=('Arial', 10), tags='skins')
        
        # Pagination settings
        skins_per_page = 15  # 3 rows of 5
        skin_list = list(self.skins.items())
        total_pages = (len(skin_list) + skins_per_page - 1) // skins_per_page
            
        # Calculate which skins to show on current page
        start_idx = self.skin_page * skins_per_page
        end_idx = min(start_idx + skins_per_page, len(skin_list))
        skins_to_show = skin_list[start_idx:end_idx]

        # Display page number
        self.canvas.create_text(300, 62, text=f"Page {self.skin_page + 1}/{total_pages}",
                               fill='yellow', font=('Arial', 10), tags='skins')

        # Display skins in a 5-column grid with smaller boxes
        y_start = 80
        x_positions = [60, 180, 300, 420, 540]  # 5 columns
        skins_per_row = 5
        box_width = 100
        box_height = 70

        current_x_idx = 0
        current_y = y_start

        for skin_id, skin_data in skins_to_show:
            x = x_positions[current_x_idx]

            # Check if skin is unlocked
            unlocked = self.is_skin_unlocked(skin_id)

            # Skin box
            if skin_id == self.current_skin:
                box_color = 'darkblue'
                border_color = 'cyan'
                border_width = 3
            elif unlocked:
                box_color = 'darkgreen'
                border_color = 'white'
                border_width = 2
            else:
                box_color = 'darkgray'
                border_color = 'gray'
                border_width = 2

            self.canvas.create_rectangle(x - box_width//2, current_y,
                                         x + box_width//2, current_y + box_height,
                                         fill=box_color, outline=border_color, width=border_width,
                                         tags=f'skin_{skin_id}')

            if unlocked:
                # Draw preview of player with skin colors
                player_preview_y = current_y + 20
                self.canvas.create_oval(x - 10, player_preview_y - 10,
                                       x + 10, player_preview_y + 10,
                                       fill=skin_data['color'], outline=skin_data['outline'],
                                       width=2, tags=f'skin_{skin_id}')

                # Skin name - smaller font
                self.canvas.create_text(x, current_y + 40, text=skin_data['name'],
                                       fill='yellow', font=('Arial', 7, 'bold'),
                                       tags=f'skin_{skin_id}', width=90)

                # Show "EQUIPPED" if current
                if skin_id == self.current_skin:
                    self.canvas.create_text(x, current_y + 60, text="EQUIPPED",
                                           fill='cyan', font=('Arial', 7, 'bold'), tags=f'skin_{skin_id}')

                # Bind click to equip skin
                self.canvas.tag_bind(f'skin_{skin_id}', '<Button-1>',
                                    lambda e, s=skin_id: self.equip_skin(s))
            else:
                # Locked skin
                self.canvas.create_text(x, current_y + 20, text="🔒",
                                       font=('Arial', 20), tags=f'skin_{skin_id}')
                self.canvas.create_text(x, current_y + 50, text="Locked",
                                       fill='gray', font=('Arial', 8), tags=f'skin_{skin_id}')

            # Move to next position
            current_x_idx += 1
            if current_x_idx >= skins_per_row:
                current_x_idx = 0
                current_y += box_height + 8

        # Navigation buttons row
        button_y = 340

        # Previous page button (only show if not on first page)
        if self.skin_page > 0:
            self.canvas.create_rectangle(50, button_y, 150, button_y + 30,
                                         fill='darkblue', outline='white',
                                         width=3, tags='prev_button')
            self.canvas.create_text(100, button_y + 15, text="◄ PREV", fill='white',
                                   font=('Arial', 14, 'bold'), tags='prev_button')
            self.canvas.tag_bind('prev_button', '<Button-1>', 
                                lambda e: self.change_skin_page(-1))

        # Achievements button (center)
        self.canvas.create_rectangle(200, button_y - 20, 400, button_y + 10,
                                     fill='purple', outline='white',
                                     width=3, tags='achievements_button')
        self.canvas.create_text(300, button_y - 5, text="ACHIEVEMENTS", fill='white',
                               font=('Arial', 14, 'bold'), tags='achievements_button')
        self.canvas.tag_bind('achievements_button', '<Button-1>', lambda e: self.show_achievements())

        # Next page button (only show if not on last page)
        if self.skin_page < total_pages - 1:
            self.canvas.create_rectangle(450, button_y, 550, button_y + 30,
                                         fill='darkblue', outline='white',
                                         width=3, tags='next_button')
            self.canvas.create_text(500, button_y + 15, text="NEXT ►", fill='white',
                                   font=('Arial', 14, 'bold'), tags='next_button')
            self.canvas.tag_bind('next_button', '<Button-1>', 
                                lambda e: self.change_skin_page(1))

        # Back button (bottom)
        self.canvas.create_rectangle(200, 360, 400, 395,
                                     fill='darkgreen', outline='white',
                                     width=3, tags='back_button')
        self.canvas.create_text(300, 380, text="BACK", fill='white',
                               font=('Arial', 16, 'bold'), tags='back_button')
        self.canvas.tag_bind('back_button', '<Button-1>', lambda e: self.show_achievements())

        self.canvas.create_rectangle(460, 5, 595, 30,
                             fill='darkgoldenrod', outline='gold',
                             width=2, tags='shop_button')
        self.canvas.create_text(527, 17, text=f"SHOP 🪙{self.coins}",
                            fill='white', font=('Arial', 11, 'bold'), tags='shop_button')
        self.canvas.tag_bind('shop_button', '<Button-1>', lambda e: self.show_shop())

    def equip_skin(self, skin_id):
        if skin_id != self.current_skin:  # Only count if actually changing to a different skin
            self.skin_changes_before_game += 1
        self.current_skin = skin_id
        self.save_achievements()
        self.show_skins()

    def show_shop(self):
        self.game_state = 'shop'
        self.canvas.delete('all')

        self.canvas.create_text(300, 25, text="SKIN SHOP" if self.shop_page == 0 else "UPGRADES",
                            fill='gold', font=('Arial', 24, 'bold'))
        self.canvas.create_text(300, 50, text=f"🪙 {self.coins} coins",
                            fill='yellow', font=('Arial', 14))
        self.canvas.create_text(300, 68, text="Earn coins by playing (score / 10)",
                            fill='gray', font=('Arial', 9))
        self.canvas.create_text(300, 390, text=f"Page {self.shop_page + 1}/2",
                            fill='yellow', font=('Arial', 10))

        if self.shop_page == 0:
            # Skins page
            positions = [
                (100, 140), (300, 140), (500, 140),
                (100, 260), (300, 260), (500, 260),
            ]
            box_width = 180
            box_height = 100

            for idx, (skin_id, price) in enumerate(self.shop_skins.items()):
                if idx >= len(positions):
                    break
                x, y = positions[idx]
                skin = self.skins[skin_id]
                purchased = skin_id in self.purchased_skins

                box_color = 'darkgreen' if purchased else 'gray20'
                border_color = 'gold' if purchased else 'gray'

                self.canvas.create_rectangle(x - box_width//2, y - box_height//2,
                                            x + box_width//2, y + box_height//2,
                                            fill=box_color, outline=border_color,
                                            width=2, tags=f'shop_{skin_id}')

                self.canvas.create_oval(x - box_width//2 + 15, y - 15,
                                    x - box_width//2 + 45, y + 15,
                                    fill=skin['color'], outline=skin['outline'],
                                    width=2, tags=f'shop_{skin_id}')

                self.canvas.create_text(x + 10, y - 22, text=skin['name'],
                                    fill='white', font=('Arial', 11, 'bold'),
                                    tags=f'shop_{skin_id}')

                if purchased:
                    self.canvas.create_text(x + 10, y + 5, text="OWNED",
                                        fill='lime', font=('Arial', 10),
                                        tags=f'shop_{skin_id}')
                else:
                    can_afford = self.coins >= price
                    price_color = 'yellow' if can_afford else 'red'
                    self.canvas.create_text(x + 10, y + 5, text=f"🪙 {price} coins",
                                        fill=price_color, font=('Arial', 10),
                                        tags=f'shop_{skin_id}')
                    if can_afford:
                        self.canvas.create_rectangle(x - 35, y + 25, x + 35, y + 45,
                                                    fill='darkgreen', outline='white',
                                                    width=2, tags=f'buy_{skin_id}')
                        self.canvas.create_text(x, y + 35, text="BUY",
                                            fill='white', font=('Arial', 10, 'bold'),
                                            tags=f'buy_{skin_id}')
                        self.canvas.tag_bind(f'buy_{skin_id}', '<Button-1>',
                                            lambda e, s=skin_id, p=price: self.purchase_skin(s, p))

        else:
            # Upgrades page
            positions = [
                (150, 140), (450, 140),
                (150, 250), (450, 250),
            ]

            for idx, (upgrade_id, upgrade) in enumerate(self.shop_upgrades.items()):
                if idx >= len(positions):
                    break
                x, y = positions[idx]
                purchased = upgrade_id in self.purchased_upgrades
                box_color = 'darkgreen' if purchased else 'gray20'
                border_color = 'cyan' if purchased else 'gray'

                self.canvas.create_rectangle(x - 120, y - 50, x + 120, y + 50,
                                            fill=box_color, outline=border_color,
                                            width=2, tags=f'upgrade_{upgrade_id}')

                self.canvas.create_text(x, y - 25,
                                    text=f"{upgrade['icon']} {upgrade['name']}",
                                    fill='white', font=('Arial', 11, 'bold'),
                                    tags=f'upgrade_{upgrade_id}')

                self.canvas.create_text(x, y - 5, text=upgrade['description'],
                                    fill='lightgray', font=('Arial', 8),
                                    width=220, tags=f'upgrade_{upgrade_id}')

                if purchased:
                    is_enabled = upgrade_id in self.enabled_upgrades
                    status_color = 'lime' if is_enabled else 'gray'
                    status_text = 'ENABLED' if is_enabled else 'DISABLED'
                    self.canvas.create_text(x, y + 15, text=status_text,
                                        fill=status_color, font=('Arial', 10, 'bold'),
                                        tags=f'upgrade_{upgrade_id}')
                    toggle_color = 'darkred' if is_enabled else 'darkgreen'
                    toggle_text = 'DISABLE' if is_enabled else 'ENABLE'
                    self.canvas.create_rectangle(x - 30, y + 28, x + 30, y + 43,
                                                fill=toggle_color, outline='white',
                                                width=1, tags=f'toggle_{upgrade_id}')
                    self.canvas.create_text(x, y + 35, text=toggle_text,
                                        fill='white', font=('Arial', 8, 'bold'),
                                        tags=f'toggle_{upgrade_id}')
                    self.canvas.tag_bind(f'toggle_{upgrade_id}', '<Button-1>',
                                        lambda e, u=upgrade_id, p=upgrade['price']: self.purchase_upgrade(u, p))
                    
                else:  # ADD THIS ENTIRE ELSE BLOCK
                    can_afford = self.coins >= upgrade['price']
                    price_color = 'yellow' if can_afford else 'red'
                    self.canvas.create_text(x, y + 18, text=f"🪙 {upgrade['price']} coins",
                                        fill=price_color, font=('Arial', 10),
                                        tags=f'upgrade_{upgrade_id}')
                    if can_afford:
                        self.canvas.create_rectangle(x - 30, y + 28, x + 30, y + 43,
                                                    fill='darkgreen', outline='white',
                                                    width=1, tags=f'buy_upgrade_{upgrade_id}')
                        self.canvas.create_text(x, y + 35, text="BUY",
                                            fill='white', font=('Arial', 9, 'bold'),
                                            tags=f'buy_upgrade_{upgrade_id}')
                        self.canvas.tag_bind(f'buy_upgrade_{upgrade_id}', '<Button-1>',
                                            lambda e, u=upgrade_id, p=upgrade['price']: self.purchase_upgrade(u, p))

        # Navigation buttons
        if self.shop_page > 0:
            self.canvas.create_rectangle(50, 355, 150, 380,
                                        fill='darkblue', outline='white',
                                        width=2, tags='prev_shop')
            self.canvas.create_text(100, 367, text="◄ SKINS", fill='white',
                                font=('Arial', 10, 'bold'), tags='prev_shop')
            self.canvas.tag_bind('prev_shop', '<Button-1>',
                                lambda e: self.change_shop_page(-1))

        if self.shop_page < 1:
            self.canvas.create_rectangle(450, 355, 550, 380,
                                        fill='darkblue', outline='white',
                                        width=2, tags='next_shop')
            self.canvas.create_text(500, 367, text="UPGRADES ►", fill='white',
                                font=('Arial', 10, 'bold'), tags='next_shop')
            self.canvas.tag_bind('next_shop', '<Button-1>',
                                lambda e: self.change_shop_page(1))

        # Back button
        self.canvas.create_rectangle(200, 355, 400, 380,
                                    fill='darkgreen', outline='white',
                                    width=2, tags='back_button')
        self.canvas.create_text(300, 367, text="BACK", fill='white',
                            font=('Arial', 12, 'bold'), tags='back_button')
        self.canvas.tag_bind('back_button', '<Button-1>', lambda e: self.show_skins())


    def change_shop_page(self, direction):
        self.shop_page += direction
        self.show_shop()

    def purchase_upgrade(self, upgrade_id, price):
        if upgrade_id in self.purchased_upgrades:
            # Already bought - toggle enabled/disabled
            if upgrade_id in self.enabled_upgrades:
                self.enabled_upgrades.remove(upgrade_id)
            else:
                self.enabled_upgrades.append(upgrade_id)
            self.save_achievements()
        elif self.coins >= price:
            # New purchase - buy and enable
            self.coins -= price
            self.purchased_upgrades.append(upgrade_id)
            self.enabled_upgrades.append(upgrade_id)
            self.save_achievements()
        self.show_shop()
        
    def purchase_skin(self, skin_id, price):
        if self.coins >= price and skin_id not in self.purchased_skins:
            self.coins -= price
            self.purchased_skins.append(skin_id)
            self.save_achievements()
            self.unlock_achievement('first_purchase')

            # Check if all shop skins purchased
            if all(s in self.purchased_skins for s in self.shop_skins):
                self.unlock_achievement('all_purchased')

        self.show_shop()
    def update_fps(self):
        self.fps_frame_count += 1
        current_time = time.time()
        elapsed = current_time - self.last_time
        if elapsed >= 1.0:  # update every second
            self.fps = self.fps_frame_count
            self.fps_frame_count = 0
            self.last_time = current_time

    def start_game(self):
        import datetime
        current_hour = datetime.datetime.now().hour
        if current_hour >= 22 or current_hour < 2:
            self.unlock_achievement('secret_midnight')
        if current_hour < 8:
            self.unlock_achievement('secret_sunrise')

        # Reset game state
        self.game_state = 'playing'
        self.game_running = False
        self.paused = False

        # Reset cutscene
        self.in_cutscene = True
        self.cutscene_timer = 0
        self.dialogue_index = 0

        # Reset figure/boss
        self.figure_x = self.GAME_WIDTH // 2
        self.figure_y = self.GAME_HEIGHT // 2
        self.boss_hp = 5
        self.boss_defeated = False

        # Reset phase
        self.phase = 1
        self.phase2_pattern = 0
        self.patterns_completed = 0
        self.pattern_timer = 0
        self.pattern_type = 0
        self.pattern_sub_timer = 0
        self.wave_offset = 0
        self.spiral_angle = 0

        # Reset transitions
        self.transitioning_to_phase2 = False
        self.phase2_transition_timer = 0
        self.phase2_dialogue_index = 0

        # Reset victory
        self.in_victory = False
        self.victory_timer = 0
        self.victory_dialogue_index = 0
        self.player_disappeared = False

        # Reset stars
        self.star_active = False
        self.star_collected = 0
        self.key_press_count = 0
        self.star_timer = 0

        # Reset player
        self.player_x = self.battle_box_x + 20
        self.player_y = self.battle_box_y + self.BATTLE_BOX_HEIGHT - 20
        self.hp = 20
        self.score = 0
        self.invulnerable = False
        self.invuln_timer = 0

        # Reset bullets
        self.bullets = []

        # Reset power-ups
        self.power_up_active = False
        self.power_up_type = None
        self.power_up_timer = 0

        # Reset particles
        self.healing_particles = []

        # Reset achievement tracking
        self.damage_taken_this_game = 0
        self.power_ups_used_this_game = set()
        self.power_ups_collected_this_game = 0
        self.game_start_time = time.time()
        self.shield_broken = False

        # Clear canvas and create UI
        self.canvas.delete('all')
        self.create_ui()
    
        # Identity Crisis - changed skin 5+ times before playing
        if self.skin_changes_before_game >= 5:
            self.unlock_achievement('identity_crisis')
        self.skin_changes_before_game = 0  # Reset for next time

        # First steps - play for first time
        self.unlock_achievement('first_steps')

        # Apply permanent upgrades
        if 'extra_hp' in self.enabled_upgrades:
            self.max_hp = 25
            self.hp = 25
        else:
            self.max_hp = 20
            self.hp = 20

    def update_shake(self):
        if self.shake_duration > 0:
            self.shake_x = random.randint(-self.shake_intensity, self.shake_intensity)
            self.shake_y = random.randint(-self.shake_intensity, self.shake_intensity)
            self.shake_duration -= 1
        else:
            self.shake_x = 0
            self.shake_y = 0
            self.shake_intensity = 0
        
        self.canvas.place(x=self.shake_x, y=self.shake_y)

    def create_ui(self):
        # Draw battle box
        self.battle_box = self.canvas.create_rectangle(
            self.battle_box_x, self.battle_box_y,
            self.battle_box_x + self.BATTLE_BOX_WIDTH,
            self.battle_box_y + self.BATTLE_BOX_HEIGHT,
            outline='white', width=3, fill='', tags='ui'
        )

        # HP bar background
        self.canvas.create_rectangle(45, 45, 250, 70, fill='red', tags='ui')

        # Instructions
        self.canvas.create_text(self.GAME_WIDTH//2, 15, text="WASD/Arrows to move • Survive! • Stars heal you!",
                               fill='white', font=('Arial', 11), tags='ui')

    def update_ui(self):
        self.canvas.delete('fps')
        fps_color = 'lime' if self.fps >= 33 else 'yellow' if self.fps >= 25 else 'red'
        self.canvas.create_text(10, 10, text=f"FPS: {self.fps}",
                            fill=fps_color, font=('Arial', 9),
                            anchor='w', tags='fps')
        # Clear old UI
        self.canvas.delete('hp_bar')
        self.canvas.delete('score_text')
        self.canvas.delete('pattern_text')
        self.canvas.delete('boss_hp_bar')
        self.canvas.delete('phase_text')

        # HP bar (green portion)
        hp_width = int(200 * (self.hp / self.max_hp))
        if hp_width > 0:
            self.canvas.create_rectangle(45, 45, 50 + hp_width, 70, fill='lime', tags='hp_bar')

        # HP text
        self.canvas.create_text(150, 58, text=f"HP: {self.hp}/{self.max_hp}",
                               fill='white', font=('Arial', 10, 'bold'), tags='hp_bar')

        # Score
        self.canvas.create_text(400, 60, text=f"Score: {self.score}",
                               fill='white', font=('Arial', 12), tags='score_text')

        # Power-up indicator
        if self.power_up_active:
            power_up_names = {
                'speed': '⚡ SPEED BOOST',
                'shield': '🛡️ SHIELD',
                'slowmo': '🕐 SLOW-MO',
                'clear': '✨ BULLET CLEAR'
            }
            power_up_colors = {
                'speed': 'yellow',
                'shield': 'cyan',
                'slowmo': 'magenta',
                'clear': 'white'
            }
            self.canvas.create_text(300, 85,
                                   text=power_up_names.get(self.power_up_type, ''),
                                   fill=power_up_colors.get(self.power_up_type, 'white'),
                                   font=('Arial', 12, 'bold'), tags='score_text')
            # Add a countdown for the 'clear' power-up delay
            if self.power_up_type == 'clear' and self.power_up_timer > 0:
                seconds = self.power_up_timer / 60
                self.canvas.create_text(300, 105, text=f"Clear in: {seconds:.2f}",
                       fill='white', font=('Arial', 10), tags='score_text')

        # Phase indicator
        if self.phase == 1:
            pattern_names = ["Spiral", "Wall", "Random", "Cross", "Laser", "Homing", "Wave", "Burst", "Ring", "Snake"]
            self.canvas.create_text(550, 30, text=f"Pattern: {pattern_names[self.pattern_type]}",
                                fill='yellow', font=('Arial', 10), tags='pattern_text')
            self.canvas.create_text(550, 45, text=f"Phase 1 ({self.patterns_completed}/10)",
                                fill='cyan', font=('Arial', 9), tags='phase_text')
            
            # Pattern timer countdown
            frames_remaining = 120 - (self.pattern_timer % 240)
            seconds = frames_remaining // 60
            milliseconds = (frames_remaining % 60) * 100 // 60  # Convert to 2 digit ms
            self.canvas.create_text(550, 57, text=f"Next: {seconds}:{milliseconds:02d}",
                                fill='gray', font=('Arial', 9), tags='pattern_text')
        else:
            # Phase 2 - Boss HP bar
            boss_hp_width = int(300 * (self.boss_hp / self.boss_max_hp))
            self.canvas.create_rectangle(150, 25, 450, 50, fill='darkred', outline='white', width=2, tags='boss_hp_bar')
            if boss_hp_width > 0:
                self.canvas.create_rectangle(150, 25, 150 + boss_hp_width, 50, fill='red', tags='boss_hp_bar')
            self.canvas.create_text(300, 37, text=f"BOSS HP: {self.boss_hp}/{self.boss_max_hp}",
                                   fill='white', font=('Arial', 10, 'bold'), tags='boss_hp_bar')

            phase2_names = ["Chaos Storm", "Death Spiral", "Void Prison", "Meteor Rain", "Final Judgement"]
            self.canvas.create_text(525, 30, text=f"Attack: {phase2_names[self.phase2_pattern]}",
                                   fill='red', font=('Arial', 9, 'bold'), tags='pattern_text')
            self.canvas.create_text(550, 45, text=f"PHASE 2 ({self.star_collected}/5)",
                                   fill='magenta', font=('Arial', 9, 'bold'), tags='phase_text')
            
            # Pattern timer countdown for phase 2
            if not self.star_active:
                frames_remaining = 360 - self.pattern_sub_timer
                seconds = max(0, frames_remaining) // 60
                milliseconds = (max(0, frames_remaining) % 60) * 100 // 60
                self.canvas.create_text(550, 57, text=f"Star in: {seconds}:{milliseconds:02d}",
                                    fill='gray', font=('Arial', 9), tags='pattern_text')
            else:
                self.canvas.create_text(550, 57, text="Collect the star!",
                                    fill='gold', font=('Arial', 9, 'bold'), tags='pattern_text')

    def key_press(self, event):
        self.keys_pressed.add(event.keysym.lower())
        if self.game_running:
            self.key_press_count += 1
            if self.key_press_count >= 500:
                self.unlock_achievement('secret_buttonmasher')

        # Track Konami code sequence (in menu only)
        if self.game_state == 'start_menu':
            konami = ['up', 'up', 'down', 'down', 'left', 'right', 'left', 'right']
            self.konami_sequence.append(event.keysym.lower())

            # Keep only last 8 keys
            if len(self.konami_sequence) > 8:
                self.konami_sequence.pop(0)

            # Check if sequence matches
            if self.konami_sequence == konami:
                self.unlock_achievement('secret_konami')
                self.konami_sequence = []  # Reset

        # Press 2 to spawn to star
        if event.keysym == '2':
            if self.game_state == 'playing':
                if self.phase == 2 and self.game_running and not self.star_active:
                    self.bullets = []
                    self.pattern_sub_timer = 360
                    self.spawn_star()

        # Press 3 to skip attack
        if event.keysym == '3':
            if self.game_state == 'playing':
                if self.phase == 1 and self.game_running:
                    self.bullets = []
                    self.pattern_type = (self.pattern_type + 1) % 10
                    self.pattern_sub_timer = 0
                    self.pattern_timer = 0
                    self.patterns_completed += 1
                    if self.patterns_completed >= 10:
                        self.start_phase2_transition()

                elif self.phase ==2:
                    self.bullets = []
                    self.phase2_pattern = (self.phase2_pattern + 1) % 5
                    self.pattern_sub_timer = 0
                    self.pattern_timer = 0

        # Press 4 to skip cutscenes
        if event.keysym == '4':
            if self.showing_boss_scold:
                self.showing_boss_scold = False
                self.show_start_menu()
            if self.game_state == 'playing':
                if self.in_cutscene:
                    self.skip_cutscene()
                elif self.transitioning_to_phase2:
                    self.skip_phase2_transition()
                elif self.in_victory:
                    self.skip_victory()

        # Press 5 to skip to Phase 2 or skip to victory
        if event.keysym == '5':
            if self.game_state == 'playing':
                if self.phase == 1 and self.game_running:
                    self.start_phase2_transition()
                elif self.phase == 2 and self.game_running:
                    # Skip to victory
                    self.game_running = False
                    self.in_victory = True
                    self.victory_timer = 0

        # Press Esc or P to pause
        if event.keysym == 'Escape' or event.keysym == 'p':
            if self.game_running:
                self.paused = not self.paused  # Toggle pause

    def key_release(self, event):
        self.keys_pressed.discard(event.keysym.lower())

    def skip_cutscene(self):
        # Skip the opening cutscene
        self.in_cutscene = False
        self.game_running = True
        self.canvas.delete('dialogue')
        self.canvas.delete('figure')
        self.canvas.itemconfig(self.battle_box, outline='white')

    def skip_phase2_transition(self):
        # Skip the Phase 2 transition dialogue
        self.transitioning_to_phase2 = False
        self.game_running = True
        self.canvas.delete('dialogue')
        self.canvas.itemconfig(self.battle_box, outline='white')

    def skip_victory(self):
        # Skip the victory dialogue and go straight to victory screen
        self.show_victory_screen()

    def move_player(self):
        dx, dy = 0, 0

        # Support both WASD and arrow keys
        if 'w' in self.keys_pressed or 'up' in self.keys_pressed:
            dy -= self.player_speed
        if 's' in self.keys_pressed or 'down' in self.keys_pressed:
            dy += self.player_speed
        if 'a' in self.keys_pressed or 'left' in self.keys_pressed:
            dx -= self.player_speed
        if 'd' in self.keys_pressed or 'right' in self.keys_pressed:
            dx += self.player_speed

        if 'w' in self.keys_pressed or 'up' in self.keys_pressed:
            self.directions_used.add('vertical')
        if 's' in self.keys_pressed or 'down' in self.keys_pressed:
            self.directions_used.add('vertical')
        if 'a' in self.keys_pressed or 'left' in self.keys_pressed:
            self.directions_used.add('horizontal')
        if 'd' in self.keys_pressed or 'right' in self.keys_pressed:
            self.directions_used.add('horizontal')

        # Apply speed power-up
        if self.power_up_active and self.power_up_type == 'speed':
            dx *= 1.5
            dy *= 1.5

        # Diagonal movement normalization
        if dx != 0 and dy != 0:
            dx *= 0.707
            dy *= 0.707

        # Update position with boundary checking
        new_x = self.player_x + dx
        new_y = self.player_y + dy

        # Wallflower tracking - check if touching any edge
        touching_edge = (
            self.player_x <= self.battle_box_x + self.PLAYER_SIZE + 1 or
            self.player_x >= self.battle_box_x + self.BATTLE_BOX_WIDTH - self.PLAYER_SIZE - 1 or
            self.player_y <= self.battle_box_y + self.PLAYER_SIZE + 1 or
            self.player_y >= self.battle_box_y + self.BATTLE_BOX_HEIGHT - self.PLAYER_SIZE - 1
        )

        if touching_edge and self.game_running:
            self.wallflower_timer += 1
            if self.wallflower_timer >= 300:  # 10 seconds at 30fps
                self.unlock_achievement('wallflower')
        else:
            self.wallflower_timer = 0  # Reset if they leave the edge
        # Keep player within battle box
        if (self.battle_box_x + self.PLAYER_SIZE <= new_x <=
            self.battle_box_x + self.BATTLE_BOX_WIDTH - self.PLAYER_SIZE):
            self.player_x = new_x

        if (self.battle_box_y + self.PLAYER_SIZE <= new_y <=
            self.battle_box_y + self.BATTLE_BOX_HEIGHT - self.PLAYER_SIZE):
            self.player_y = new_y

        # Update power-up timer
        if self.power_up_active:
            self.power_up_timer -= 1
            if self.power_up_timer <= 0:
                if self.power_up_type == 'clear':
                    # Trigger clear effect now that delay is over
                    self.bullets = []
                    # Grant temporary invulnerability after clear
                    self.invulnerable = True
                    self.invuln_timer = 60 # 1 second invulnerability after clearing
                    # Power-up is consumed
                    self.power_up_active = False
                    self.power_up_type = None
                else: # For other power-ups, duration ends
                    self.power_up_active = False
                    self.power_up_type = None

        # Statue tracking - check if player hasn't moved
        if (abs(self.player_x - self.last_player_x) < 0.1 and 
            abs(self.player_y - self.last_player_y) < 0.1 and
            self.game_running and len(self.bullets) > 0):
            self.statue_timer += 1
            if self.statue_timer >= 120:  # 4 seconds at 30fps
                self.unlock_achievement('statue')
        else:
            self.statue_timer = 0

        self.last_player_x = self.player_x
        self.last_player_y = self.player_y

    def handle_cutscene(self):
        self.canvas.delete('figure')
        self.cutscene_timer += 1

        # Display dialogue
        if self.dialogue_index < len(self.dialogue):
            self.canvas.delete('dialogue')
            self.canvas.create_text(
                self.GAME_WIDTH // 2, self.GAME_HEIGHT - 70,
                text=self.dialogue[self.dialogue_index],
                fill='white', font=('Arial', 14), tags='dialogue'
            )

            # Advance dialogue every 2 seconds
            if self.cutscene_timer % 100 == 0:
                self.dialogue_index += 1

        # Move figure to top after dialogue is complete
        elif self.dialogue_index >= len(self.dialogue):
            if self.figure_y > self.figure_target_y:
                self.figure_y -= self.figure_speed
            else:
                # Start battle
                self.in_cutscene = False
                self.game_running = True
                self.canvas.delete('dialogue')
                self.canvas.delete('figure')
                self.canvas.itemconfig(self.battle_box, outline='white')

    def handle_phase2_transition(self):
        self.phase2_transition_timer += 1

        # Clear all bullets
        if self.phase2_transition_timer == 1:
            self.bullets = []

        # Flash effect
        if self.phase2_transition_timer % 20 < 10:
            self.canvas.itemconfig(self.battle_box, outline='red')
        else:
            self.canvas.itemconfig(self.battle_box, outline='purple')

        # Display dialogue
        if self.phase2_dialogue_index < len(self.phase2_dialogue):
            self.canvas.delete('dialogue')
            # Create text box background for better readability
            text = self.phase2_dialogue[self.phase2_dialogue_index]
            self.canvas.create_rectangle(50, self.GAME_HEIGHT - 90, 550, self.GAME_HEIGHT - 49,
                                        fill='black', outline='red', width=2, tags='dialogue')
            self.canvas.create_text(
                self.GAME_WIDTH // 2, self.GAME_HEIGHT - 70,
                text=text,
                fill='red', font=('Arial', 14, 'bold'), tags='dialogue'
            )

            if self.phase2_transition_timer % 120 == 0:
                self.phase2_dialogue_index += 1
        else:
            # Transition complete
            if self.phase2_transition_timer > 360:
                self.transitioning_to_phase2 = False
                self.game_running = True
                self.canvas.delete('dialogue')
                self.canvas.itemconfig(self.battle_box, outline='white')

    def handle_victory(self):
        self.victory_timer += 1

        # Clear bullets and hide player on first frame
        if self.victory_timer == 1:
            self.bullets = []
            self.player_disappeared = True
            self.shake_intensity = 10
            self.shake_duration = 60

        # Only proceed with dialogue/flash after shake is done
        if self.shake_duration > 0:
            return  # Wait for shake
            
        # Victory flash (only after shake)
        if self.victory_timer % 30 < 15:
            self.canvas.itemconfig(self.battle_box, outline='gold')
        else:
            self.canvas.itemconfig(self.battle_box, outline='yellow')

        # Display victory dialogue
        if self.victory_dialogue_index < len(self.victory_dialogue):
            self.canvas.delete('dialogue')
            text = self.victory_dialogue[self.victory_dialogue_index]
            self.canvas.create_rectangle(50, self.GAME_HEIGHT - 90, 550, self.GAME_HEIGHT - 49,
                                        fill='black', outline='gold', width=2, tags='dialogue')
            self.canvas.create_text(
                self.GAME_WIDTH // 2, self.GAME_HEIGHT - 70,
                text=text,
                fill='gold', font=('Arial', 14, 'bold'), tags='dialogue'
            )

            if self.victory_timer % 120 == 0:
                self.victory_dialogue_index += 1
        else:
            if self.victory_timer > 360:
                self.show_victory_screen()

    def show_victory_screen(self):
        self.game_running = False
        self.in_victory = False
        self.game_state = 'victory'
        self.boss_defeated = False
        self.canvas.delete('all')


        self.coins += self.score // 10
        self.save_achievements()

        # Update high score
        if self.score > self.high_score:
            self.high_score = self.score
            self.save_achievements()
        
        # Check victory achievements
        self.check_victory_achievements()

        self.canvas.create_rectangle(80, 80, 520, 320, fill='black', outline='gold', width=4, tags='victory')
        self.canvas.create_text(300, 120, text="VICTORY!", fill='gold',
                               font=('Arial', 32, 'bold'), tags='victory')
        self.canvas.create_text(300, 160, text=f"Final Score: {self.score}",
                               fill='white', font=('Arial', 18), tags='victory')
        self.canvas.create_text(300, 200, text=f"Best: {self.high_score}",
                       fill='yellow', font=('Arial', 12), tags='victory')
        self.canvas.create_text(300, 180, text="You have defeated the boss!",
                               fill='yellow', font=('Arial', 14), tags='victory')
        self.canvas.create_text(300, 220, text="Phase 1: All 10 patterns survived",
                               fill='cyan', font=('Arial', 11), tags='victory')
        self.canvas.create_text(300, 240, text="Phase 2: All 5 ultimate attacks defeated",
                               fill='magenta', font=('Arial', 11), tags='victory')

        # Show newly unlocked achievements
        if self.newly_unlocked:
            unlock_count = len(self.newly_unlocked)
            self.canvas.create_text(300, 265, text=f"🏆 {unlock_count} Achievement{'s' if unlock_count != 1 else ''} Unlocked!",
                                   fill='gold', font=('Arial', 12, 'bold'), tags='victory')

        # Return to menu button
        self.canvas.create_rectangle(200, 280, 400, 310,
                                     fill='darkgreen', outline='white',
                                     width=2, tags='menu_button')
        self.canvas.create_text(300, 295, text="RETURN TO MENU", fill='white',
                               font=('Arial', 12, 'bold'), tags='menu_button')

        # Bind the button properly
        self.canvas.tag_bind('menu_button', '<Button-1>', lambda e: self.show_start_menu())

    def trigger_true_ending(self):
        self.game_running = False
        self.bullets = []
        self.in_true_ending = True
        self.true_ending_timer = 0
        self.true_ending_dialogue_index = 0
        self.true_ending_dialogue = [
            "...",
            "Are you even trying?",
            "I've been standing here for like 10 minutes.",
            "You know what, I have places to be.",
            "Consider yourself... not defeated.",
            "I'm leaving. Don't follow me.",
        ]

    def handle_true_ending(self):
        self.true_ending_timer += 1

        if self.true_ending_dialogue_index < len(self.true_ending_dialogue):
            self.canvas.delete('dialogue')
            text = self.true_ending_dialogue[self.true_ending_dialogue_index]
            self.canvas.create_rectangle(50, self.GAME_HEIGHT - 90, 550, self.GAME_HEIGHT - 49,
                                        fill='black', outline='gray', width=2, tags='dialogue')
            self.canvas.create_text(
                self.GAME_WIDTH // 2, self.GAME_HEIGHT - 70,
                text=text,
                fill='gray', font=('Arial', 14), tags='dialogue'
            )
            if self.true_ending_timer % 120 == 0:
                self.true_ending_dialogue_index += 1
        else:
            if self.true_ending_timer > 360:
                self.show_true_ending_screen()

    def show_true_ending_screen(self):
