    def draw_battle_box_background(self):
        if not self.animated_bg:
            return
        self.canvas.delete('battle_bg')

        if self.phase == 1:
            # Phase 1 - scrolling blue grid
            offset = int(self.pattern_timer * 0.5) % 20
            for x in range(self.battle_box_x, self.battle_box_x + self.BATTLE_BOX_WIDTH, 20):
                self.canvas.create_line(x + offset, self.battle_box_y,
                                        x + offset, self.battle_box_y + self.BATTLE_BOX_HEIGHT,
                                        fill='#111133', width=1, tags='battle_bg')
            for y in range(self.battle_box_y, self.battle_box_y + self.BATTLE_BOX_HEIGHT, 20):
                self.canvas.create_line(self.battle_box_x, y + offset,
                                        self.battle_box_x + self.BATTLE_BOX_WIDTH, y + offset,
                                        fill='#111133', width=1, tags='battle_bg')

        elif self.phase == 2:
            # Phase 2 - green grid
            offset = int(self.pattern_timer * 0.5) % 20
            for x in range(self.battle_box_x, self.battle_box_x + self.BATTLE_BOX_WIDTH, 20):
                self.canvas.create_line(x + offset, self.battle_box_y,
                                        x + offset, self.battle_box_y + self.BATTLE_BOX_HEIGHT,
                                        fill='#0a1f0a', width=1, tags='battle_bg')
            for y in range(self.battle_box_y, self.battle_box_y + self.BATTLE_BOX_HEIGHT, 20):
                self.canvas.create_line(self.battle_box_x, y + offset,
                                        self.battle_box_x + self.BATTLE_BOX_WIDTH, y + offset,
                                        fill='#0a1f0a', width=1, tags='battle_bg')

            # Faint flying stars
            if not hasattr(self, 'bg_stars'):
                self.bg_stars = []

            # Spawn new stars occasionally
            if self.pattern_timer % 8 == 0 and len(self.bg_stars) < 20:
                side = random.choice(['left', 'right', 'top', 'bottom'])
                if side == 'left':
                    x = self.battle_box_x
                    y = random.randint(self.battle_box_y, self.battle_box_y + self.BATTLE_BOX_HEIGHT)
                    dx = random.uniform(0.3, 0.8)
                    dy = random.uniform(-0.3, 0.3)
                elif side == 'right':
                    x = self.battle_box_x + self.BATTLE_BOX_WIDTH
                    y = random.randint(self.battle_box_y, self.battle_box_y + self.BATTLE_BOX_HEIGHT)
                    dx = random.uniform(-0.8, -0.3)
                    dy = random.uniform(-0.3, 0.3)
                elif side == 'top':
                    x = random.randint(self.battle_box_x, self.battle_box_x + self.BATTLE_BOX_WIDTH)
                    y = self.battle_box_y
                    dx = random.uniform(-0.3, 0.3)
                    dy = random.uniform(0.3, 0.8)
                else:
                    x = random.randint(self.battle_box_x, self.battle_box_x + self.BATTLE_BOX_WIDTH)
                    y = self.battle_box_y + self.BATTLE_BOX_HEIGHT
                    dx = random.uniform(-0.3, 0.3)
                    dy = random.uniform(-0.8, -0.3)

                self.bg_stars.append({
                    'x': x, 'y': y,
                    'dx': dx, 'dy': dy,
                    'size': random.uniform(1.5, 3.5),
                    'alpha': random.uniform(0.3, 0.7),  # faintness level
                    'twinkle': random.randint(0, 30)  # offset so they don't all pulse together
                })

            # Update and draw stars
            stars_to_remove = []
            for i, star in enumerate(self.bg_stars):
                star['x'] += star['dx']
                star['y'] += star['dy']
                star['twinkle'] += 1

                # Remove if out of bounds
                # Remove if out of bounds
                if (star['x'] < self.battle_box_x or
                    star['x'] > self.battle_box_x + self.BATTLE_BOX_WIDTH or
                    star['y'] < self.battle_box_y or
                    star['y'] > self.battle_box_y + self.BATTLE_BOX_HEIGHT):
                    stars_to_remove.append(i)
                    continue

                # Twinkle effect - alternate between two faint greens
                pulse = math.sin(star['twinkle'] * 0.1)
                if pulse > 0:
                    color = '#1a3d1a'
                else:
                    color = '#0d260d'

                s = star['size']
                self.canvas.create_oval(
                    star['x'] - s, star['y'] - s,
                    star['x'] + s, star['y'] + s,
                    fill=color, outline='', tags='battle_bg')

            for i in reversed(stars_to_remove):
                del self.bg_stars[i]

        self.canvas.tag_lower('battle_bg')

    def unlock_all_achievements(self):
        self.cheat_button_uses += 1
        self.save_achievements()

        # ADD THIS:
        if self.cheat_button_uses >= 3:
            self.scold_dialogue = ["Go away."]
            self.showing_boss_scold = True
            self.scold_timer = 0
            self.scold_dialogue_index = 0
            self.canvas.delete('all')
            self.draw_boss_scold()
            return

        for skin_id in self.shop_skins:
            if skin_id not in self.purchased_skins:
                self.purchased_skins.append(skin_id)
        for upgrade_id in self.shop_upgrades:  # ADD THIS
            if upgrade_id not in self.purchased_upgrades:
                self.purchased_upgrades.append(upgrade_id)
        self.save_achievements()

        if self.cheat_button_uses == 1:
            # First time - only non-secret achievements + new secret
            for ach_id, ach in self.achievements.items():
                if not ach['hidden']:
                    self.unlock_achievement(ach_id)
            self.unlock_achievement('secret_cheater')
            self.unlock_achievement('secret_shameful')  # new secret
            self.show_boss_scold()

        else:
            # Second time onwards - everything
            for ach_id in self.achievements:
                self.unlock_achievement(ach_id)
            self.coins += 1000000
            self.show_boss_scold()

    def show_boss_scold(self):
        self.canvas.delete('all')
        self.scold_timer = 0
        self.scold_dialogue_index = 0

        if self.cheat_button_uses == 1:
            self.scold_dialogue = [
                "...",
                "Really?",
                "You couldn't just... play the game?",
                "I worked HARD on those bullet patterns.",
                "The spiral alone took me WEEKS to perfect.",
                "And you just... clicked a button.",
                "A tiny, hidden, shameful little button.",
                "I hope you're happy with yourself.",
                "...",
                "Get out of my settings page.",
            ]
        else:
            self.scold_dialogue = [
                "...",
                "You came back.",
                "You actually came back and did it AGAIN.",
                "I gave you a second chance and you just...",
                "You know what, I'm not even angry.",
                "I'm just disappointed.",
                "Actually no, I AM angry.",
                "WHAT IS WRONG WITH YOU.",
                "Fine. FINE. Take your achievements.",
                "I hope the skins were worth it.",
                "They weren't, were they.",
                "Have fun with those coins, too."
                "...",
                "Please just go.",
            ]

        self.showing_boss_scold = True
        self.draw_boss_scold()

    def draw_boss_scold(self):
        if not self.showing_boss_scold:
            return

        self.canvas.delete('scold')
        self.scold_timer += 1

        boss_x, boss_y = 300, 150
        self.boss_glow += 0.1
        glow_size = 5 + abs(math.sin(self.boss_glow) * 3)

        # Flashing outline
        if int(self.scold_timer / 15) % 2 == 0:
            outline_color = 'purple'
        else:
            outline_color = 'magenta'

        # Outer glow
        self.canvas.create_oval(
            boss_x - 30 - glow_size, boss_y - 30 - glow_size,
            boss_x + 30 + glow_size, boss_y + 30 + glow_size,
            fill='', outline=outline_color, width=2, tags='scold')

        # Middle layer
        self.canvas.create_oval(
            boss_x - 25, boss_y - 25,
            boss_x + 25, boss_y + 25,
            fill='darkviolet', outline='', tags='scold')

        # Core (flashing)
        core_color = 'white' if int(self.scold_timer / 20) % 2 == 0 else 'lightgrey'
        self.canvas.create_oval(
            boss_x - 15, boss_y - 15,
            boss_x + 15, boss_y + 15,
            fill=core_color, outline=outline_color, width=2, tags='scold')

        # Angry eyes
        eye_color = 'red' if int(self.scold_timer / 10) % 2 == 0 else 'crimson'
        eye_offset = 8
        self.canvas.create_oval(
            boss_x - eye_offset - 4, boss_y - 5,
            boss_x - eye_offset + 4, boss_y + 3,
            fill=eye_color, outline='', tags='scold')
        self.canvas.create_oval(
            boss_x + eye_offset - 4, boss_y - 5,
            boss_x + eye_offset + 4, boss_y + 3,
            fill=eye_color, outline='', tags='scold')

        # Dialogue box
        if self.scold_dialogue_index < len(self.scold_dialogue):
            text = self.scold_dialogue[self.scold_dialogue_index]
            self.canvas.create_rectangle(50, 220, 550, 270,
                                        fill='black', outline='purple',
                                        width=2, tags='scold')
            self.canvas.create_text(300, 245, text=text,
                                fill='white', font=('Arial', 13),
                                tags='scold')

            if self.scold_timer % 60 == 0:
                self.scold_dialogue_index += 1
        else:
            timeout = 60 if len(self.scold_dialogue) == 1 else 360
            if self.scold_timer > timeout:
                self.showing_boss_scold = False
                self.canvas.delete('scold')
                self.show_start_menu()  # BACK TO MAIN MENU
                return

        self.root.after(16, self.draw_boss_scold)

