    def unlock_all_achievements(self):
        self.cheat_button_uses += 1
        self.save_achievements()

        # ADD THIS:
        if self.cheat_button_uses >= 3:
            self.scold_dialogue = ["Go away."]
            self.showing_boss_scold = True
            self.scold_timer = 0
            self.scold_dialogue_index = 0
            self.canvas.delete('all')
            self.draw_boss_scold()
            return

        for skin_id in self.shop_skins:
            if skin_id not in self.purchased_skins:
                self.purchased_skins.append(skin_id)
        for upgrade_id in self.shop_upgrades:  # ADD THIS
            if upgrade_id not in self.purchased_upgrades:
                self.purchased_upgrades.append(upgrade_id)
        self.save_achievements()

        if self.cheat_button_uses == 1:
            # First time - only non-secret achievements + new secret
            for ach_id, ach in self.achievements.items():
                if not ach['hidden']:
                    self.unlock_achievement(ach_id)
            self.unlock_achievement('secret_cheater')
            self.unlock_achievement('secret_shameful')  # new secret
            self.show_boss_scold()

        else:
            # Second time onwards - everything
            for ach_id in self.achievements:
                self.unlock_achievement(ach_id)
            self.coins += 1000000
            self.show_boss_scold()

    def show_boss_scold(self):
        self.canvas.delete('all')
        self.scold_timer = 0
        self.scold_dialogue_index = 0

        if self.cheat_button_uses == 1:
            self.scold_dialogue = [
                "...",
                "Really?",
                "You couldn't just... play the game?",
                "I worked HARD on those bullet patterns.",
                "The spiral alone took me WEEKS to perfect.",
                "And you just... clicked a button.",
                "A tiny, hidden, shameful little button.",
                "I hope you're happy with yourself.",
                "...",
                "Get out of my settings page.",
            ]
        else:
            self.scold_dialogue = [
                "...",
                "You came back.",
                "You actually came back and did it AGAIN.",
                "I gave you a second chance and you just...",
                "You know what, I'm not even angry.",
                "I'm just disappointed.",
                "Actually no, I AM angry.",
                "WHAT IS WRONG WITH YOU.",
                "Fine. FINE. Take your achievements.",
                "I hope the skins were worth it.",
                "They weren't, were they.",
                "Have fun with those coins, too."
                "...",
                "Please just go.",
            ]

        self.showing_boss_scold = True
        self.draw_boss_scold()

    def draw_boss_scold(self):
        if not self.showing_boss_scold:
            return

        self.canvas.delete('scold')
        self.scold_timer += 1

        boss_x, boss_y = 300, 150
        self.boss_glow += 0.1
        glow_size = 5 + abs(math.sin(self.boss_glow) * 3)

        # Flashing outline
        if int(self.scold_timer / 15) % 2 == 0:
            outline_color = 'purple'
        else:
            outline_color = 'magenta'

        # Outer glow
        self.canvas.create_oval(
            boss_x - 30 - glow_size, boss_y - 30 - glow_size,
            boss_x + 30 + glow_size, boss_y + 30 + glow_size,
            fill='', outline=outline_color, width=2, tags='scold')

        # Middle layer
        self.canvas.create_oval(
            boss_x - 25, boss_y - 25,
            boss_x + 25, boss_y + 25,
            fill='darkviolet', outline='', tags='scold')

        # Core (flashing)
        core_color = 'white' if int(self.scold_timer / 20) % 2 == 0 else 'lightgrey'
        self.canvas.create_oval(
            boss_x - 15, boss_y - 15,
            boss_x + 15, boss_y + 15,
            fill=core_color, outline=outline_color, width=2, tags='scold')

        # Angry eyes
        eye_color = 'red' if int(self.scold_timer / 10) % 2 == 0 else 'crimson'
        eye_offset = 8
        self.canvas.create_oval(
            boss_x - eye_offset - 4, boss_y - 5,
            boss_x - eye_offset + 4, boss_y + 3,
            fill=eye_color, outline='', tags='scold')
        self.canvas.create_oval(
            boss_x + eye_offset - 4, boss_y - 5,
            boss_x + eye_offset + 4, boss_y + 3,
            fill=eye_color, outline='', tags='scold')

        # Dialogue box
        if self.scold_dialogue_index < len(self.scold_dialogue):
            text = self.scold_dialogue[self.scold_dialogue_index]
            self.canvas.create_rectangle(50, 220, 550, 270,
                                        fill='black', outline='purple',
                                        width=2, tags='scold')
            self.canvas.create_text(300, 245, text=text,
                                fill='white', font=('Arial', 13),
                                tags='scold')

            if self.scold_timer % 60 == 0:
                self.scold_dialogue_index += 1
        else:
            timeout = 60 if len(self.scold_dialogue) == 1 else 360
            if self.scold_timer > timeout:
                self.showing_boss_scold = False
                self.canvas.delete('scold')
                self.show_start_menu()  # BACK TO MAIN MENU
                return

        self.root.after(16, self.draw_boss_scold)

