    def draw_animated_title(self):
        self.canvas.delete('title')
        self.title_animation_timer += 1

        # Pulse size
        pulse = abs(math.sin(self.title_animation_timer * 0.05)) * 4
        font_size = int(36 + pulse)

        # Cycle through gold colors
        colors = ['gold', 'yellow', 'goldenrod', 'darkgoldenrod', 'orange', 'goldenrod', 'yellow']
        color_index = (self.title_animation_timer // 8) % len(colors)
        title_color = colors[color_index]

        # Subtle vertical bob
        bob = math.sin(self.title_animation_timer * 0.07) * 3
        title_y = 80 + bob

        # Shadow for depth
        self.canvas.create_text(303, title_y + 3, text="OVERSTORY",
                            fill='darkgoldenrod',
                            font=('Arial', font_size, 'bold'), tags='title')

        # Main title
        self.canvas.create_text(300, title_y, text="OVERSTORY",
                            fill=title_color,
                            font=('Arial', font_size, 'bold'), tags='title')

        # Subtitle pulse
        subtitle_colors = ['white', 'lightgray', 'white', 'lightyellow']
        sub_color = subtitle_colors[(self.title_animation_timer // 15) % len(subtitle_colors)]
        self.canvas.create_text(300, 115, text="The Final Battle",
                            fill=sub_color,
                            font=('Arial', 18), tags='title')

    def draw_screen_background(self):
        self.canvas.delete('screen_bg')
        self.menu_animation_timer += 1

        if self.game_state == 'settings':
            # Slow moving horizontal lines
            for i in range(8):
                y = (i * 60 + self.menu_animation_timer) % self.GAME_HEIGHT
                self.canvas.create_line(0, y, self.GAME_WIDTH, y,
                                    fill='darkblue', width=1, tags='screen_bg')

        elif self.game_state == 'credits':
            # Falling stars
            if self.menu_animation_timer % 20 == 0:
                self.menu_bullets.append({
                    'x': random.randint(0, self.GAME_WIDTH),
                    'y': 0,
                    'dx': random.uniform(-0.5, 0.5),
                    'dy': random.uniform(1, 2),
                    'color': random.choice(['gold', 'yellow', 'white']),
                })
            for bullet in self.menu_bullets:
                bullet['x'] += bullet['dx']
                bullet['y'] += bullet['dy']
                self.canvas.create_oval(bullet['x'] - 2, bullet['y'] - 2,
                                    bullet['x'] + 2, bullet['y'] + 2,
                                    fill=bullet['color'], outline='', tags='screen_bg')
            self.menu_bullets = [b for b in self.menu_bullets 
                                if b['y'] < self.GAME_HEIGHT]

        elif self.game_state == 'achievements':
            # Slow rotating ring of dots
            cx, cy = 300, 200
            for i in range(12):
                angle = i * math.pi / 6 + self.menu_animation_timer * 0.02
                x = cx + math.cos(angle) * 280
                y = cy + math.sin(angle) * 180
                self.canvas.create_oval(x - 3, y - 3, x + 3, y + 3,
                                    fill='purple', outline='', tags='screen_bg')

        elif self.game_state == 'skins':
        # Bouncing orbs in different skin colors
            skin_colors = ['red', 'blue', 'gold', 'cyan', 'magenta', 'lime', 'orange']
            for i in range(7):
                x = (math.sin(self.menu_animation_timer * 0.03 + i * 1.2) * 250 + 300)
                y = (math.cos(self.menu_animation_timer * 0.02 + i * 0.9) * 150 + 200)
                color = skin_colors[i]
                self.canvas.create_oval(x - 5, y - 5, x + 5, y + 5,
                                    fill=color, outline='white', tags='screen_bg')
                # Trail effect
                trail_x = (math.sin(self.menu_animation_timer * 0.03 + i * 1.2 - 0.2) * 250 + 300)
                trail_y = (math.cos(self.menu_animation_timer * 0.02 + i * 0.9 - 0.2) * 150 + 200)
                self.canvas.create_oval(trail_x - 3, trail_y - 3, trail_x + 3, trail_y + 3,
                                    fill=color, outline='', tags='screen_bg')


        elif self.game_state == 'secret_shop':
            if not hasattr(self, '_ss_stars') or not self._ss_stars:
                self._ss_stars = [
                    {
                        'x': random.randint(0, 600), 'y': random.randint(0, 400),
                        'r': random.uniform(1, 3), 'phase': random.uniform(0, 6.28),
                        'dx': random.uniform(-0.3, 0.3), 'dy': random.uniform(-0.3, 0.3),
                    }
                    for _ in range(60)
                ]
            t = getattr(self, '_ss_t', 0) + 1
            self._ss_t = t
            for s in self._ss_stars:
                # Move the star
                s['x'] += s['dx']
                s['y'] += s['dy']
                # Bounce off edges so they stay on screen
                if s['x'] < 0 or s['x'] > 600:
                    s['dx'] *= -1
                if s['y'] < 0 or s['y'] > 400:
                    s['dy'] *= -1
                brightness = abs(math.sin(t * 0.04 + s['phase']))
                shade = int(brightness * 180)
                col = f'#{shade:02x}00{min(255, shade + 60):02x}'
                self.canvas.create_oval(
                    s['x'] - s['r'], s['y'] - s['r'],
                    s['x'] + s['r'], s['y'] + s['r'],
                    fill=col, outline='', tags='screen_bg')
                
        elif self.game_state == 'shop':
            # Floating coins
            for i in range(6):
                x = (i * 110 + 50 + math.sin(self.menu_animation_timer * 0.04 + i) * 20)
                y = ((self.menu_animation_timer * (0.5 + i * 0.1) + i * 70) % self.GAME_HEIGHT)
                # Coin circle
                self.canvas.create_oval(x - 8, y - 8, x + 8, y + 8,
                                    fill='darkgoldenrod', outline='gold',
                                    width=2, tags='screen_bg')

        self.canvas.tag_lower('screen_bg')

        if self.hint_popup_active and self.game_state == 'achievements':
            self.draw_hint_popup()

